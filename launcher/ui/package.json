{
  "name": "falcon-launcher-ui",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "description": "The Falcon Launcher's window: a React page shown by the system WebView2 runtime, built into ONE html file that the launcher exe carries.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3"
  }
}
